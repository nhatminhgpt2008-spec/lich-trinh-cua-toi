rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dữ liệu lịch trình của từng tài khoản: chỉ chính chủ tài khoản (uid khớp)
    // mới được đọc/ghi. request.auth do Firebase Auth cấp ở phía server, người
    // dùng không thể giả mạo uid từ trình duyệt.
    match /users/{uid}/planner/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tài liệu dùng-chung-bằng-khóa trước đây (LEGACY_SYNC_KEY trong index.html).
    // Giữ lại CHỈ ĐỂ đọc một lần khi di chuyển dữ liệu cũ (migrateLegacyShared());
    // không cho ghi mới vào đây nữa. Sau khi đã di chuyển xong dữ liệu của bạn,
    // có thể xóa hẳn khối này.
    match /planner/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Mặc định: chặn tất cả những gì không khớp ở trên.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
